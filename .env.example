# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# GitHub OAuth (optional: can also be configured via settings table after setup)
GITHUB_CLIENT_ID=your-github-client-id

# Dev only: check database tables on startup (true/false)
DB_CHECK=true

# LLM Chat (OpenAI-compatible API)
LLM_API_BASE=https://your-api-base/v1
LLM_MODEL=your-api-key
LLM_MODEL=glm-4.7
