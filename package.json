    "@vueuse/motion": "^3.0.3",
    "better-sqlite3": "^11.10.0",
    "cheerio": "^1.1.2",
    "dayjs": "^1.11.13",
    "db0": "^0.2.4",
    "defu": "^6.1.4",
    "echarts": "^5.6.0",
    "element-plus": "^2.11.5",
    "fast-xml-parser": "^4.5.3",
    "h3": "1.8.2",
    "jose": "^5.9.6",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.5.0",
