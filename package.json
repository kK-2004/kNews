    "eslint": "^9.30.1",
    "cross-env": "^7.0.3",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^25.0.1",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-vue-components": "^28.8.0",
    "unocss": "^66.4.2",
    "vite": "^6.3.5",
    "vite-plugin-with-nitro": "^0.0.3",
    "vitest": "^2.1.8"
